<Window x:Class="Relay.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="NearDrop · 安心傳檔" Width="1080" Height="760" MinWidth="660" MinHeight="445" Loaded="OnLoaded" Closing="OnClosing">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="NearDrop" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="讓檔案，安心抵達。" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="EngineStatus" Text="正在啟動安全傳輸…" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#AAC9B9"/></DockPanel>
  <TabControl x:Name="Tabs" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" SelectedIndex="4" SelectionChanged="TabChanged">
   <TabItem x:Name="SendTab" Header="傳送"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,0,0,0">
    <TextBlock Text="傳送檔案" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20"/>
    <Border AutomationProperties.Name="拖曳檔案或資料夾到這裡" Background="{StaticResource Surface}" BorderBrush="#57665F" BorderThickness="1" CornerRadius="10" Padding="20" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragged"><StackPanel><TextBlock Text="把檔案或資料夾拖到這裡" FontSize="21" HorizontalAlignment="Center" Margin="0,12,0,10"/><TextBlock Text="保留名稱與資料夾結構，送達後由朋友獨立保存。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0"><Button x:Name="PickFilesButton" Content="加入檔案" Click="PickFiles"/><Button x:Name="PickFolderButton" Content="加入資料夾" Click="PickFolder"/></WrapPanel></StackPanel></Border>
    <TextBlock x:Name="SelectionSummary" Text="尚未選取檔案" Foreground="{StaticResource Muted}" Margin="0,16,0,12"/>
    <StackPanel x:Name="DraftPanel" Visibility="Collapsed"><ListBox x:Name="DraftItems" Height="115" DisplayMemberPath="Display" SelectionChanged="ActionSelectionChanged" AutomationProperties.Name="待傳送檔案與資料夾"/><TextBox x:Name="DraftLocalPath" AutomationProperties.Name="選取傳送項目的來源路徑" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/><WrapPanel Margin="0,8,0,4"><Button x:Name="RemoveDraftButton" Content="移除選取項目" Click="RemoveDraftItem"/><Button x:Name="ClearDraftButton" Content="清空清單" Click="ClearDraft"/></WrapPanel></StackPanel><TextBlock Text="傳給誰" FontWeight="SemiBold" Margin="0,4,0,8"/><ListBox x:Name="SendFriends" AutomationProperties.Name="傳送對象" SelectionChanged="ActionSelectionChanged" DisplayMemberPath="Display" Height="96"/>
    <Button x:Name="NoFriends" Content="新增朋友" Click="GoToPairing" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="20,12,0,0"><Border x:Name="PreparationPanel" Visibility="Collapsed" Background="{StaticResource Surface}" Padding="12" Margin="0,0,0,10" CornerRadius="6"><StackPanel><TextBlock Text="準備傳送" FontWeight="SemiBold"/><TextBlock x:Name="PreparationText" Margin="0,5,0,8"/><ProgressBar x:Name="PreparationBar" Height="8" AutomationProperties.Name="目前檔案的暫存進度"/><Button x:Name="CancelPreparationButton" Content="取消準備" Click="CancelPreparation" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="SendButton" Content="傳送" Click="SendFiles" Margin="0,0,16,0"/><TextBlock x:Name="SendHint" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Text="正在啟動…" Foreground="{StaticResource Muted}"/></Grid></StackPanel></Grid></TabItem>
   <TabItem x:Name="ReceiveTab" Header="接收"><Grid Margin="20,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="接收檔案" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="接受邀請後即可收件。單次收件完成後可獨立保存，持續同步則可開啟同步資料夾。" Foreground="{StaticResource Muted}" Margin="0,10,0,8"/><DockPanel Margin="0,0,0,10"><Button x:Name="NextIncomingButton" DockPanel.Dock="Right" Content="查看下一筆待處理" Click="GoToNextIncoming" Visibility="Collapsed" Margin="10,0,0,0"/><TextBlock x:Name="IncomingSummary" Text="正在更新收件…" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel></StackPanel><ListBox Grid.Row="1" x:Name="Incoming" AutomationProperties.Name="接收邀請和檔案" SelectionChanged="ActionSelectionChanged" DisplayMemberPath="Display"/><StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="IncomingHint" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><TextBox x:Name="IncomingLocalPath" AutomationProperties.Name="選取收件的本機資料夾路徑" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/><WrapPanel><Button x:Name="AcceptButton" Content="接受邀請" Click="AcceptIncoming"/><Button x:Name="DeclineButton" Content="拒絕邀請" Click="DeclineIncoming"/><Button x:Name="SaveButton" Content="保存到收件資料夾" Click="SaveIncoming"/><Button x:Name="OpenReceivedButton" Content="開啟此筆保存資料夾" Click="OpenReceived"/><Button x:Name="OpenReceivedWatchButton" Content="開啟同步資料夾" Click="OpenReceivedWatch" Visibility="Collapsed"/><Button Content="開啟單次收件保存位置" Click="OpenInbox"/></WrapPanel></StackPanel></Grid></TabItem>
   <TabItem x:Name="WatchTab" Header="自動傳送"><Grid Margin="20,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="固定資料夾" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="持續單向同步：包含修改與刪除。朋友不能反向更改你的來源。" Foreground="{StaticResource Muted}" Margin="0,10,0,18"/></StackPanel><ListBox x:Name="Watches" AutomationProperties.Name="持續同步工作" SelectionChanged="ActionSelectionChanged" Grid.Row="1" DisplayMemberPath="Display"/><StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBox x:Name="WatchLocalPath" AutomationProperties.Name="選取同步工作的本機資料夾路徑" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/><WrapPanel><Button x:Name="AddWatchButton" Content="新增資料夾" Click="AddWatch"/><Button x:Name="OpenWatchButton" Content="開啟同步資料夾" Click="OpenWatch" IsEnabled="False"/><Button x:Name="ToggleWatchButton" Content="暫停" Click="ToggleWatch"/><Button x:Name="StopWatchButton" Content="停止持續同步" Click="StopWatch"/></WrapPanel></StackPanel></Grid></TabItem>
   <TabItem x:Name="HistoryTab" Header="傳輸紀錄">
    <Grid Margin="20,0,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="傳輸紀錄" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="對方已接收時，保存狀態仍可能未知。" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
      <TextBlock x:Name="HistorySearchLabel" Text="搜尋工作名稱、朋友或日期"/>
      <TextBox x:Name="HistorySearch" AutomationProperties.LabeledBy="{Binding ElementName=HistorySearchLabel}" TextChanged="HistoryFilterChanged" Margin="0,4,0,8"/>
      <WrapPanel VerticalAlignment="Center">
       <TextBlock Text="狀態" VerticalAlignment="Center" Margin="0,0,8,8"/>
       <ComboBox x:Name="HistoryStatusFilter" AutomationProperties.Name="篩選狀態" SelectedIndex="0" SelectionChanged="HistoryFilterChanged" MinWidth="132" Margin="0,0,16,8" VerticalAlignment="Center" Padding="5,3">
        <ComboBoxItem Content="所有狀態"/><ComboBoxItem Content="進行中／等待"/><ComboBoxItem Content="待保存"/><ComboBoxItem Content="對方已同步／已獨立保存"/><ComboBoxItem Content="需要處理"/><ComboBoxItem Content="已暫停／已停止"/>
       </ComboBox>
       <TextBlock Text="方向" VerticalAlignment="Center" Margin="0,0,8,8"/>
       <ComboBox x:Name="HistoryDirectionFilter" AutomationProperties.Name="篩選方向" SelectedIndex="0" SelectionChanged="HistoryFilterChanged" MinWidth="98" Margin="0,0,16,8" VerticalAlignment="Center" Padding="5,3">
        <ComboBoxItem Content="所有方向"/><ComboBoxItem Content="傳送"/><ComboBoxItem Content="接收"/>
       </ComboBox>
       <Button x:Name="ResetHistoryButton" Content="清除條件" Click="ResetHistoryFilters" Padding="10,5"/>
      </WrapPanel>
      <TextBlock x:Name="HistoryResults" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
     </StackPanel>
     <ListBox x:Name="History" AutomationProperties.Name="傳輸工作紀錄" SelectionChanged="ActionSelectionChanged" Grid.Row="1" DisplayMemberPath="HistoryDisplay">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding HistoryDisplay}"/></Style></ListBox.ItemContainerStyle>
     </ListBox>
     <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="ViewIncomingButton" Content="前往此筆收件" Click="ViewIncoming" IsEnabled="False"/><Button x:Name="RetryButton" Content="重試／恢復" Click="RetryTransfer"/><Button x:Name="StopTransferButton" Content="停止這次傳送" Click="CancelTransfer"/><Button x:Name="OpenOutboxButton" Content="開啟傳送暫存" Click="OpenOutbox"/><Button x:Name="ClearOutboxButton" Content="清理傳送暫存" Click="ClearOutbox"/></WrapPanel>
    </Grid>
   </TabItem>
   <TabItem x:Name="DeviceTab" Header="我的裝置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,0,0,0">
    <TextBlock Text="我的裝置" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="複製我的裝置 ID 給朋友，貼上朋友的完整 ID，雙方核對後各自加入。" Foreground="{StaticResource Muted}" Margin="0,10,0,8"/>
    <TextBox x:Name="MyId" AutomationProperties.Name="我的裝置 ID" IsReadOnly="True" Text="正在建立裝置身分…" FontFamily="Consolas" TextWrapping="Wrap"/><Button x:Name="CopyIdButton" Content="複製我的裝置 ID" Click="CopyId" IsEnabled="False" HorizontalAlignment="Left"/>
    <TextBlock Text="新增朋友" FontSize="19" FontWeight="SemiBold" Margin="0,20,0,8"/>
    <TextBlock x:Name="FriendNameLabel" Text="朋友名稱"/><TextBox x:Name="FriendName" AutomationProperties.LabeledBy="{Binding ElementName=FriendNameLabel}" MaxLength="80"/>
    <TextBlock x:Name="FriendIdLabel" Text="朋友的完整裝置 ID"/><TextBox x:Name="FriendId" AutomationProperties.LabeledBy="{Binding ElementName=FriendIdLabel}" FontFamily="Consolas" TextWrapping="Wrap"/>
    <CheckBox x:Name="Verified" Content="我們已核對雙方的完整裝置 ID，對方也會明確加入我。"/>
    <Button x:Name="AddFriendButton" Content="加入朋友" Click="AddFriend" HorizontalAlignment="Left"/>
    <TextBlock Text="已授權的朋友" FontWeight="SemiBold" Margin="0,16,0,8"/><ListBox x:Name="Friends" AutomationProperties.Name="已授權的朋友" SelectionChanged="ActionSelectionChanged" DisplayMemberPath="Display" Height="140"/><Button x:Name="RemoveFriendButton" Content="解除配對與共享權限" Click="RemoveFriend" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="SettingsTab" Header="設定"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,0,0,0"><TextBlock Text="依你的方式傳檔" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="單次收件保存位置" Margin="0,26,0,0"/><TextBox x:Name="InboxPath" AutomationProperties.Name="單次收件保存資料夾路徑" IsReadOnly="True"/><Button Content="變更保存位置" Click="ChangeInbox" HorizontalAlignment="Left"/><CheckBox x:Name="KeepBackground" Content="關閉視窗後，繼續在系統匣傳輸" IsChecked="True"/><CheckBox x:Name="StartAtLogin" Content="登入 Windows 時在背景啟動" Click="ChangeStartup"/><CheckBox x:Name="ReceiveNotifications" Content="通知我有新邀請或檔案待保存"/><WrapPanel Margin="0,8"><Button Content="加入右鍵傳送到" Click="InstallSendTo"/><CheckBox x:Name="ExplorerHotkey" Content="使用 Ctrl+Alt+N 帶入檔案總管選取項目"/></WrapPanel><TextBlock Text="安全與隱私" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,12"/><TextBlock Text="使用 Syncthing 官方加密傳輸。公共探索服務可取得裝置 ID 與對外連線位址，以尋找已配對的裝置。經由中繼傳輸時，中繼服務可看到連線 IP、時間與流量，檔案內容仍經端對端加密。沒有線上帳號、廣告或檔案內容收集。" Foreground="{StaticResource Muted}"/><TextBlock Text="Windows 可能詢問是否允許網路連線；不需管理員安裝。未開放直接連線時，可能透過中繼且較慢。" Foreground="{StaticResource Muted}" Margin="0,14"/><TextBlock Text="NearDrop 0.1.15 預覽版 · Syncthing 2.1.7 · MPL 2.0" Foreground="{StaticResource Muted}" Margin="0,16"/><Button Content="開啟安全與授權說明" Click="OpenDocs" HorizontalAlignment="Left"/><Button Content="退出並停止背景傳輸" Click="ExitApp" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Border x:Name="PageMessage" Grid.Row="2" Background="#252F2B" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock x:Name="Notice" AutomationProperties.LiveSetting="Polite"/></Border>
 </Grid>
</Window>
